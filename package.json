{
  "name": "@mieweb/redmine-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Redmine — exposes the Redmine REST API (issues, projects, users, time entries, search) as MCP tools for any MCP-compatible client such as VS Code, Claude Desktop, or Cursor.",
  "type": "module",
  "bin": {
    "redmine-mcp": "./index.js"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "systemd"
  ],
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js",
    "eval:tools": "npx -y promptfoo@0.124.0 eval -c evals/tools.yaml --no-cache",
    "eval:tools:mock": "REDMINE_URL=http://127.0.0.1:8765 REDMINE_API_KEY=mock REDMINE_EVAL_PROJECT=sandbox REDMINE_EVAL_ISSUE=1234 npx -y promptfoo@0.124.0 eval -c evals/tools.yaml --no-cache",
    "eval:routing": "npx -y promptfoo@0.124.0 eval -c evals/routing.yaml --no-cache",
    "eval:redteam": "npx -y promptfoo@0.124.0 redteam run -c evals/redteam.config.yaml",
    "eval:view": "npx -y promptfoo@0.124.0 view"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "redmine",
    "redmine-api",
    "redmine-mcp",
    "ai",
    "llm",
    "claude",
    "copilot",
    "vscode",
    "cursor",
    "agents",
    "project-management",
    "issue-tracker",
    "mieweb"
  ],
  "author": "MIE (Medical Informatics Engineering)",
  "license": "MIT",
  "homepage": "https://github.com/mieweb/redmine-mcp#readme",
  "bugs": {
    "url": "https://github.com/mieweb/redmine-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/redmine-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
