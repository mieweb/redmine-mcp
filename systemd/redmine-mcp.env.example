# Copy to /etc/redmine-mcp.env, then:
#   sudo chown root:redmine-mcp /etc/redmine-mcp.env
#   sudo chmod 0640 /etc/redmine-mcp.env
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell quoting.

# Required: base URL of your Redmine instance.
REDMINE_URL=https://redmine.example.com

# Optional default API key. Omit it entirely if every client sends its own
# `Authorization: Bearer <redmine-api-key>` header — that always takes precedence.
#REDMINE_API_KEY=your-redmine-api-key

# HTTP listener.
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=127.0.0.1

# Enable DNS-rebinding protection by allow-listing the Host headers you serve.
#MCP_ALLOWED_HOSTS=redmine-mcp.example.com,127.0.0.1:3000

# Audit logging of requests and tool calls to the journal is on by default.
# Set to 0 to turn it off.
#MCP_LOG_REQUESTS=0

# Impersonation (admin keys only) — see README.
# Prefer having your reverse proxy inject an identity header per request; it
# overrides these and cannot be chosen by the model. Ordered, first match wins:
#REDMINE_USER_HEADERS=x-redmine-user,x-redmine-on-behalf-of,x-on-behalf-of,x-ozwell-user-email,x-ozwell-user-name
#REDMINE_ON_BEHALF_OF=jdoe@example.com
#REDMINE_LOCK_ON_BEHALF_OF=1
#REDMINE_ALLOW_ADMIN=1
